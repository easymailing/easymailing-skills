#!/bin/bash
# Uso interno de em-api: em-secret <item> <campo>. Lee un campo del vault «Marcos OpenClaw»
# con la cuenta de servicio de 1Password (token en el Llavero, servicio em-1password-sa).
# Límite de 20 s por lectura (EM_SECRET_TIMEOUT) con un reintento. Caché de 15 min en $TMPDIR/em-secret-$UID (dir 700, ficheros 600). Nunca lo uses para mostrar secretos.
set -u
item="$1"; campo="$2"
dir="${TMPDIR:-/tmp}/em-secret-$(id -u)"; mkdir -p "$dir"; chmod 700 "$dir"
f="$dir/$(printf '%s/%s' "$item" "$campo" | shasum -a 256 | cut -c1-32)"
if [ -f "$f" ] && [ -z "$(find "$f" -mmin +15 2>/dev/null)" ]; then cat "$f"; exit 0; fi
sa=$(security find-generic-password -s em-1password-sa -w 2>/dev/null) || {
  echo "em-secret: no hay token de cuenta de servicio en el Llavero (ver AGENTS.md de easymailing-skills)" >&2; exit 3; }
# op consulta los servidores de 1Password: límite de EM_SECRET_TIMEOUT s (20 por defecto) y un reintento.
# macOS no trae `timeout`: perl lanza op en su propio grupo de procesos y, si vence el plazo,
# mata el grupo entero (hijos incluidos, que si no mantendrían abierta la salida) y sale con 142.
leer() {
  OP_SERVICE_ACCOUNT_TOKEN="$sa" perl -e '
    my $t = shift; my $pid = fork // exit 1;
    if (!$pid) { setpgrp(0, 0); exec @ARGV or exit 127 }
    local $SIG{ALRM} = sub { kill "KILL", -$pid; waitpid($pid, 0); exit 142 };
    alarm $t; waitpid($pid, 0); exit($? >> 8)' "${EM_SECRET_TIMEOUT:-20}" op read "op://Marcos OpenClaw/$item/$campo" 2>/dev/null
}
val=$(leer); rc=$?
[ $rc = 142 ] && { val=$(leer); rc=$?; }
if [ $rc = 142 ]; then echo "em-secret: 1Password no responde (2 intentos de ${EM_SECRET_TIMEOUT:-20} s); reintenta en unos minutos" >&2; exit 3; fi
[ $rc = 0 ] || { echo "em-secret: no se pudo leer el item '$item' (campo '$campo') del vault" >&2; exit 3; }
umask 077; printf '%s' "$val" > "$f"; chmod 600 "$f"
printf '%s' "$val"
