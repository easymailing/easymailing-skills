#!/bin/bash
# em-api <servicio> <MÉTODO> <ruta|url> [--data <json|@fichero>] [--query k=v ...] [--form campo=@fichero]
# em-api <servicio> check
# Llama a un servicio de servicios.json con su credencial (sentinel de OpenClaw o 1Password vía em-secret).
# Solo permite los hosts declarados. Nunca imprime la credencial. Exit: 0 2xx, 1 error HTTP, 2 uso/host.
set -u
REPO="$(cd "$(dirname "$0")/.." && pwd)"
CONF="${EM_SERVICIOS:-$REPO/servicios.json}"
svc="${1:-}"; [ -n "$svc" ] || { echo "uso: em-api <servicio> <MÉTODO> <ruta>" >&2; exit 2; }
jq -e --arg s "$svc" '.[$s]' "$CONF" >/dev/null || { echo "em-api: servicio desconocido '$svc'" >&2; exit 2; }
cfg() { jq -r --arg s "$svc" ".[\$s]$1 // empty" "$CONF"; }
if [ "${2:-}" = "check" ]; then metodo=GET; ruta="$(cfg .check)"; shift 2; else metodo="${2:-}"; ruta="${3:-}"; shift 3 || true; fi
[ -n "$metodo" ] && [ -n "$ruta" ] || { echo "uso: em-api <servicio> <MÉTODO> <ruta>" >&2; exit 2; }

secreto_env="$(cfg .secreto.env)"
token="${!secreto_env:-}"
if [[ "$token" != oc-sent-* ]]; then token="$("$REPO/bin/em-secret" "$(cfg .secreto.item)" "$(cfg .secreto.campo)")" || exit 3; fi

resolver() { # sustituye {var} usando vars: env > valor > item/campo
  local s="$1" v
  for v in $(jq -r --arg s "$svc" '.[$s].vars // {} | keys[]' "$CONF"); do
    [[ "$s" == *"{$v}"* ]] || continue
    local e val; e="$(cfg ".vars.$v.env")"; val="${e:+${!e:-}}"
    [ -n "$val" ] || val="$(cfg ".vars.$v.valor")"
    [ -n "$val" ] || { local it ca; it="$(cfg ".vars.$v.item")"; ca="$(cfg ".vars.$v.campo")"; [ -n "$it" ] && val="$("$REPO/bin/em-secret" "$it" "$ca")"; }
    s="${s//\{$v\}/$val}"
  done
  printf '%s' "$s"
}
base="$(resolver "$(cfg .base_url)")"
hosts="$(resolver "$(jq -r --arg s "$svc" '.[$s].hosts | join(" ")' "$CONF")")"
if [[ "$ruta" == http* ]]; then url="$ruta"; else url="$base$ruta"; fi
host="$(printf '%s' "$url" | sed -E 's#^https?://([^/:?]+).*#\1#')"
[[ "$url" == https://* ]] && [[ " $hosts " == *" $host "* ]] || { echo "em-api: host no permitido para $svc: $host" >&2; exit 2; }

args=(-sS -X "$metodo" -w '\n%{http_code}')
case "$(cfg .auth.tipo)" in
  header) args+=(-H "$(cfg .auth.nombre): $(cfg .auth.formato | sed "s#{token}#$token#")");;
  query)  sep='?'; [[ "$url" == *\?* ]] && sep='&'; url="$url${sep}$(cfg .auth.nombre)=$token";;
  basic)  args+=(-u "$(resolver "$(cfg .auth.usuario)"):$token");;
esac
while [ $# -gt 0 ]; do
  case "$1" in
    --data) d="$2"; args+=(-H 'Content-Type: application/json'); if [[ "$d" == @* ]]; then args+=(--data-binary "$d"); else args+=(--data "$d"); fi; shift 2;;
    --query) sep='?'; [[ "$url" == *\?* ]] && sep='&'; url="$url$sep$2"; shift 2;;
    --form) args+=(-F "$2"); shift 2;;
    *) echo "em-api: opción desconocida $1" >&2; exit 2;;
  esac
done
resp="$(curl "${args[@]}" "$url" 2>&1)"
code="${resp##*$'\n'}"; body="${resp%$'\n'*}"
body="${body//$token/[REDACTED]}"
if [[ "$code" =~ ^2 ]]; then printf '%s\n' "$body"; exit 0; fi
printf 'em-api: HTTP %s\n%s\n' "$code" "$body" >&2; exit 1
