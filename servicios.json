{
  "storyblok": {
    "base_url": "https://mapi.storyblok.com/v1/spaces/{space_id}",
    "hosts": [
      "mapi.storyblok.com"
    ],
    "auth": {
      "tipo": "header",
      "nombre": "Authorization",
      "formato": "{token}"
    },
    "secreto": {
      "item": "storyblok",
      "campo": "credential",
      "env": "STORYBLOK_MANAGEMENT_TOKEN"
    },
    "vars": {
      "space_id": {
        "env": "STORYBLOK_SPACE_ID",
        "valor": "310467"
      }
    },
    "check": "/stories?per_page=1"
  },
  "storyblok-cdn": {
    "base_url": "https://api.storyblok.com/v2/cdn",
    "hosts": [
      "api.storyblok.com"
    ],
    "auth": {
      "tipo": "query",
      "nombre": "token"
    },
    "secreto": {
      "item": "storyblok-cdn-token",
      "campo": "credential",
      "env": "STORYBLOK_CDN_TOKEN"
    },
    "check": "/spaces/me"
  },
  "zendesk": {
    "base_url": "https://{subdominio}.zendesk.com/api/v2",
    "hosts": [
      "{subdominio}.zendesk.com"
    ],
    "auth": {
      "tipo": "basic",
      "usuario": "{email}/token"
    },
    "secreto": {
      "item": "zendesk-api-token",
      "campo": "credential",
      "env": "ZENDESK_API_TOKEN"
    },
    "vars": {
      "subdominio": {
        "env": "ZENDESK_SUBDOMAIN",
        "valor": "easymailing"
      },
      "email": {
        "env": "ZENDESK_EMAIL",
        "item": "zendesk-api-token",
        "campo": "username"
      }
    },
    "check": "/users/me.json"
  },
  "dataforseo": {
    "base_url": "https://api.dataforseo.com/v3",
    "hosts": [
      "api.dataforseo.com"
    ],
    "auth": {
      "tipo": "header",
      "nombre": "Authorization",
      "formato": "Basic {token}"
    },
    "secreto": {
      "item": "dataforseo",
      "campo": "credential",
      "env": "DATAFORSEO_API_TOKEN"
    },
    "check": "/appendix/user_data"
  },
  "stripe": {
    "base_url": "https://api.stripe.com/v1",
    "hosts": [
      "api.stripe.com"
    ],
    "auth": {
      "tipo": "header",
      "nombre": "Authorization",
      "formato": "Bearer {token}"
    },
    "secreto": {
      "item": "stripe-api-key",
      "campo": "credential",
      "env": "STRIPE_API_KEY"
    },
    "check": "/balance"
  },
  "openai-kb": {
    "base_url": "https://api.openai.com/v1",
    "hosts": [
      "api.openai.com"
    ],
    "auth": {
      "tipo": "header",
      "nombre": "Authorization",
      "formato": "Bearer {token}"
    },
    "cabeceras": {
      "OpenAI-Beta": "assistants=v2"
    },
    "secreto": {
      "item": "easymailing-kb-api-key",
      "campo": "credential",
      "env": "EASYMAILING_KB_API_KEY"
    },
    "check": "/vector_stores/vs_697921a6ab408191bfb8c96447b733da"
  },
  "admin-api": {
    "base_url": "https://admin-api.easymailing.com/api/admin",
    "hosts": [
      "admin-api.easymailing.com"
    ],
    "auth": {
      "tipo": "header",
      "nombre": "X-Admin-Token",
      "formato": "{token}"
    },
    "secreto": {
      "item": "admin-api-token",
      "campo": "credential",
      "env": "EASYMAILING_ADMIN_API_TOKEN"
    },
    "check": "/dashboard_stats"
  },
  "chartmogul": {
    "base_url": "https://api.chartmogul.com/v1",
    "hosts": [
      "api.chartmogul.com"
    ],
    "auth": {
      "tipo": "basic",
      "usuario": "{token}"
    },
    "secreto": {
      "item": "chartmogul-api-key",
      "campo": "credential",
      "env": "CHARTMOGUL_API_KEY"
    },
    "check": "/ping"
  },
  "mailerq": {
    "base_url": "https://bridge-agents.easymailing.com/mailerq-api",
    "hosts": [
      "bridge-agents.easymailing.com"
    ],
    "auth": {
      "tipo": "header",
      "nombre": "Authorization",
      "formato": "Bearer {token}"
    },
    "secreto": {
      "item": "mailerq-api-key",
      "campo": "credential",
      "env": "MAILERQ_API_TOKEN"
    },
    "check": "/stats/summary?hours=1"
  },
  "snds": {
    "base_url": "https://substrate.office.com/ip-domain-management-snds/SNDS",
    "hosts": [
      "substrate.office.com"
    ],
    "auth": {
      "tipo": "query",
      "nombre": "Key"
    },
    "secreto": {
      "item": "snds-key",
      "campo": "credential",
      "env": "SNDS_KEY"
    },
    "check": "/DataKey"
  }
}
